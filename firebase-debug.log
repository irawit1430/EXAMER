[debug] [2026-04-06T13:01:11.909Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/music-social-platform/rulesets {"name":"projects/music-social-platform/rulesets/7394d0d1-7239-4883-9b6e-3d85f7b6ce68","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    // Helper Functions\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    function isOwner(userId) {\n      return isAuthenticated() && request.auth.uid == userId;\n    }\n\n    function isParticipant(user1, user2) {\n      return isAuthenticated() && (request.auth.uid == user1 || request.auth.uid == user2);\n    }\n\n    function isValidMessage(data) {\n      return data.keys().hasAll(['senderId', 'receiverId', 'text', 'timestamp']) &&\n             data.senderId == request.auth.uid &&\n             data.text is string && data.text.size() > 0 && data.text.size() < 2000;\n    }\n\n    function isValidPost(data) {\n      return data.keys().hasAll(['authorId', 'videoId', 'timestamp']) &&\n             data.authorId == request.auth.uid &&\n             data.videoId is string;\n    }\n\n    // ===================================\n    // EXAMER & Users Rules\n    // ===================================\n    match /users/{userId} {\n      allow read: if isAuthenticated(); \n      allow write: if isOwner(userId);\n      \n      // Cascade to all subcollections for EXAMER (e.g. mentor_memory, progress_nodes, etc)\n      match /{document=**} {\n        allow read, write: if isOwner(userId);\n      }\n    }\n\n    match /mock_tests/{testId} {\n      allow read: if isAuthenticated();\n      allow write: if false; // Mock tests are read-only for students\n    }\n\n    // ===================================\n    // Music Social Platform Rules\n    // ===================================\n    match /matches/{matchId} {\n      allow read: if isParticipant(resource.data.user1, resource.data.user2);\n      allow create: if isAuthenticated() && isParticipant(request.resource.data.user1, request.resource.data.user2);\n    }\n\n    match /messages/{messageId} {\n      allow read: if isParticipant(resource.data.senderId, resource.data.receiverId);\n      allow create: if isAuthenticated() && isValidMessage(request.resource.data);\n    }\n\n    match /posts/{postId} {\n      allow read: if isAuthenticated();\n      allow create: if isAuthenticated() && isValidPost(request.resource.data);\n      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-04-06T13:01:13.295359Z","metadata":{"services":["cloud.firestore"]}}
